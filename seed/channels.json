[
  {
    "channelId": "6bd1bdb4-aee0-4ff2-b2e7-dc836d0a18a8",
    "channelName": "journalism-pack",
    "channelDescription": "Source verification helpers for journalists. Blocks tracker scripts on news sites.",
    "ruleCount": 4,
    "rules": [
      {
        "name": "Block social embeds",
        "description": "No FB/Twitter embeds",
        "site": "*",
        "priority": 10,
        "rulesJson": "[{\u0022type\u0022: \u0022block\u0022, \u0022match\u0022: {\u0022urlPattern\u0022: \u0022*facebook.com/plugins*\u0022}}]",
        "isEnforced": true
      },
      {
        "name": "Hide cookie nags",
        "description": "Cookie banner suppression",
        "site": "*",
        "priority": 5,
        "rulesJson": "[{\u0022css\u0022: \u0022[id*=cookie-banner]{display:none !important}\u0022, \u0022type\u0022: \u0022inject_css\u0022}]",
        "isEnforced": false
      },
      {
        "name": "Strip referrer",
        "description": "No leaky Referer headers",
        "site": "*",
        "priority": 15,
        "rulesJson": "[{\u0022css\u0022: \u0022meta[name=referrer]{display:none}\u0022, \u0022type\u0022: \u0022inject_css\u0022}]",
        "isEnforced": false
      },
      {
        "name": "Twitter widget block",
        "description": "Stop twitter widget tracking",
        "site": "*",
        "priority": 12,
        "rulesJson": "[{\u0022type\u0022: \u0022block\u0022, \u0022match\u0022: {\u0022urlPattern\u0022: \u0022*twitter.com/widgets*\u0022}}]",
        "isEnforced": true
      }
    ]
  }
]