<UserControl x:Class="BrowserApp.UI.Controls.ActiveProfilePill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="28"
             d:DesignWidth="180"
             Height="28"
             VerticalAlignment="Center">

    <UserControl.Resources>
        <Style x:Key="ProfilePillButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="3,0,10,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgSurfaceActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Button Style="{StaticResource ProfilePillButton}"
            Click="Pill_Click"
            ToolTip="Active profile · click to manage">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Avatar: 22px circle filled with the profile color, first-letter monogram inside. -->
            <Grid Width="22" Height="22" Margin="0,0,8,0">
                <Ellipse Fill="{Binding ProfileSelectorViewModel.ActiveProfile.Color, Converter={StaticResource StringToBrush}}"/>
                <TextBlock Text="{Binding ProfileSelectorViewModel.ActiveProfile.Name, Converter={StaticResource FirstLetter}}"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Profile name -->
            <TextBlock Text="{Binding ProfileSelectorViewModel.ActiveProfile.Name}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       MaxWidth="120"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Divider -->
            <Border Width="1" Height="14" Margin="8,0"
                    Background="{StaticResource BorderBrush}"
                    VerticalAlignment="Center"/>

            <!-- Privacy mode dot + label -->
            <Ellipse Width="7" Height="7"
                     Fill="{Binding Settings.PrivacyMode, Converter={StaticResource PrivacyModeToBrush}}"
                     VerticalAlignment="Center"
                     Margin="0,0,5,0"/>
            <TextBlock Text="{Binding Settings.PrivacyMode, Converter={StaticResource PrivacyModeToLabel}}"
                       FontSize="11"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- Chevron -->
            <ui:SymbolIcon Symbol="ChevronDown24"
                           FontSize="11"
                           Margin="6,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
