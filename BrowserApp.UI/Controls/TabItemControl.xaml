<UserControl x:Class="BrowserApp.UI.Controls.TabItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="TabRoot">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Tab body — pill-shaped with bottom margin so it floats above the
             address bar edge instead of touching it. -->
        <Border x:Name="TabBorder"
                Grid.Column="0"
                CornerRadius="8"
                Padding="10,6"
                Margin="1,5,1,3"
                MinWidth="60"
                MaxWidth="240"
                Cursor="Hand"
                MouseLeftButtonDown="TabBorder_MouseLeftButtonDown"
                MouseUp="TabBorder_MouseUp">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#28354A"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="False"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#1F2A3A"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Favicon -->
            <Image Grid.Column="0"
                   Source="{Binding Favicon}"
                   Width="16" Height="16"
                   Margin="0,0,8,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Loading spinner (replaces favicon when loading) -->
            <ui:ProgressRing Grid.Column="0"
                             IsIndeterminate="True"
                             Width="16" Height="16"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

            <!-- Title -->
            <TextBlock Grid.Column="1"
                       Text="{Binding Title}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

            <!-- Active indicator — thin accent line at the bottom of the pill -->
            <Border Grid.Column="0" Grid.ColumnSpan="4"
                    Height="2"
                    VerticalAlignment="Bottom"
                    Margin="4,-5,4,-5"
                    CornerRadius="1"
                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource Accent}"/>
                </Border.Background>
            </Border>

            <!-- Close button -->
            <Button Grid.Column="3"
                    x:Name="CloseButton"
                    Click="CloseButton_Click"
                    Style="{StaticResource TabCloseButtonStyle}"/>
        </Grid>
        </Border>

        <!-- Soft vertical divider — faded gradient so it dissolves at the edges.
             Hidden on the active tab. -->
        <Rectangle Grid.Column="1"
                   Width="1"
                   Margin="0,10,0,8"
                   VerticalAlignment="Stretch"
                   SnapsToDevicePixels="True">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Setter Property="Opacity" Value="0.35"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Opacity" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#505870" Offset="0.35"/>
                    <GradientStop Color="#505870" Offset="0.65"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
