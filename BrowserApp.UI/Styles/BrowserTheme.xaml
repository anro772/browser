<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         "Warm Obsidian" — Premium Dark Theme
         Warmer undertones, high layer contrast, indigo-violet accent
         ═══════════════════════════════════════════════════════════════ -->

    <!-- BACKGROUNDS — warm dark tones with clear separation -->
    <Color x:Key="BgPrimary">#1A1E2A</Color>
    <Color x:Key="BgElevated">#222736</Color>
    <Color x:Key="BgSurface">#2A3040</Color>
    <Color x:Key="BgSurfaceHover">#343B4D</Color>
    <Color x:Key="BgSurfaceActive">#3E465A</Color>

    <SolidColorBrush x:Key="BgPrimaryBrush" Color="#1A1E2A"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#222736"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#2A3040"/>
    <SolidColorBrush x:Key="BgSurfaceHoverBrush" Color="#343B4D"/>
    <SolidColorBrush x:Key="BgSurfaceActiveBrush" Color="#3E465A"/>
    <SolidColorBrush x:Key="BgGlassHeaderBrush" Color="#252B3A"/>

    <!-- ACCENT — Indigo-Violet (warm, premium, distinctive) -->
    <Color x:Key="Accent">#7C6AEF</Color>
    <Color x:Key="AccentLight">#9B8AFB</Color>
    <Color x:Key="AccentDark">#6254CC</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#7C6AEF"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#9B8AFB"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#6254CC"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#187C6AEF"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#307C6AEF"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4C7C6AEF"/>

    <!-- TEXT — slightly warm whites, better secondary readability -->
    <Color x:Key="TextPrimary">#F0F0F5</Color>
    <Color x:Key="TextSecondary">#B0B7CC</Color>
    <Color x:Key="TextTertiary">#6B7394</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B0B7CC"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6B7394"/>

    <!-- SEMANTIC — softer, modern tones -->
    <Color x:Key="Success">#6EE7B7</Color>
    <Color x:Key="Error">#FCA5A5</Color>
    <Color x:Key="Warning">#FCD34D</Color>
    <Color x:Key="Info">#93C5FD</Color>

    <SolidColorBrush x:Key="SuccessBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#93C5FD"/>

    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#186EE7B7"/>
    <SolidColorBrush x:Key="ErrorSubtleBrush" Color="#18FCA5A5"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#18FCD34D"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="#1893C5FD"/>

    <!-- ORIGIN SEMANTICS — one hue per rule source so the badge color also carries
         the live/static signal (from Claude Design recommendation). -->
    <Color x:Key="LocalOrigin">#94A3B8</Color>      <!-- slate · neutral, "this is yours" -->
    <Color x:Key="MarketOrigin">#E6A23C</Color>     <!-- amber · static / pinned -->
    <Color x:Key="ChannelOrigin">#5EEAD4</Color>    <!-- teal  · live, networked -->
    <Color x:Key="EnforcedOrigin">#F0708A</Color>   <!-- rose  · owner-locked -->

    <SolidColorBrush x:Key="LocalOriginBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="MarketOriginBrush" Color="#E6A23C"/>
    <SolidColorBrush x:Key="ChannelOriginBrush" Color="#5EEAD4"/>
    <SolidColorBrush x:Key="EnforcedOriginBrush" Color="#F0708A"/>

    <!-- Subtle halo behind the live-pulse dot — ~16% channel teal -->
    <SolidColorBrush x:Key="ChannelOriginHaloBrush" Color="#295EEAD4"/>

    <!-- Privacy-mode dot colors (used by the active-profile pill). -->
    <SolidColorBrush x:Key="PrivacyRelaxedBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="PrivacyStandardBrush" Color="#5EEAD4"/>
    <SolidColorBrush x:Key="PrivacyStrictBrush" Color="#A78BFA"/>

    <!-- BORDERS — warmer, more visible -->
    <Color x:Key="Border">#404960</Color>
    <Color x:Key="BorderSubtle">#323849</Color>

    <SolidColorBrush x:Key="BorderBrush" Color="#404960"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#323849"/>

    <!-- ═══════════════════════════════════════════════════════════════
         WPF-UI Theme Overrides
         ═══════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1A1E2A"/>

    <!-- Control fills -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A3040"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343B4D"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#3E465A"/>
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#222736"/>

    <!-- Control strokes -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#404960"/>
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#323849"/>
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#404960"/>

    <!-- Text fills -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B0B7CC"/>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6B7394"/>
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#6B7394"/>

    <!-- Accent overrides -->
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#7C6AEF"/>
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#9B8AFB"/>
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#6254CC"/>
    <Color x:Key="SystemAccentColorPrimary">#7C6AEF</Color>
    <Color x:Key="SystemAccentColorSecondary">#9B8AFB</Color>
    <Color x:Key="SystemAccentColorTertiary">#6254CC</Color>

    <!-- WPF-UI Primary-appearance button fills route through AccentFillColor*Brush —
         without these the Primary button renders in the default Windows blue
         instead of our indigo. -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#7C6AEF"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8B7BF2"/>
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#6E5DE0"/>
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#3E465A"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F1EEFF"/>
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#F1EEFF"/>
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#F1EEFF"/>
    <SolidColorBrush x:Key="AccentTextFillColorDisabledBrush" Color="#6B7394"/>

    <!-- Button foreground overrides -->
    <SolidColorBrush x:Key="ButtonForeground" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#9B8AFB"/>
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#6B7394"/>

    <!-- Subtle/secondary button overrides -->
    <SolidColorBrush x:Key="SubtleButtonForeground" Color="#B0B7CC"/>
    <SolidColorBrush x:Key="SubtleButtonForegroundPointerOver" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="SubtleButtonForegroundPressed" Color="#9B8AFB"/>
    <SolidColorBrush x:Key="SubtleButtonForegroundDisabled" Color="#6B7394"/>
    <SolidColorBrush x:Key="SubtleButtonBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="SubtleButtonBackgroundPointerOver" Color="#343B4D"/>
    <SolidColorBrush x:Key="SubtleButtonBackgroundPressed" Color="#3E465A"/>

    <!-- ToggleButton overrides -->
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#B0B7CC"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#F0F0F5"/>
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#9B8AFB"/>

    <!-- ToggleSwitch on-state — force indigo so it matches the accent everywhere. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn"             Color="#7C6AEF"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver"  Color="#8B7BF2"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed"      Color="#6E5DE0"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled"     Color="#3E465A"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn"           Color="#7C6AEF"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#8B7BF2"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed"    Color="#6E5DE0"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOnDisabled"   Color="#3E465A"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn"         Color="#F1EEFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#F1EEFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed"  Color="#F1EEFF"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#B0B7CC"/>

    <!-- ═══════════════════════════════════════════════════════════════
         Common Styles
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ThemedCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="Margin" Value="8"/>
    </Style>

    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14"/>
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         DataGrid Styles
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ThemedDataGrid" TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="RowHeight" Value="38"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="#087C6AEF"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowStyle" Value="{DynamicResource ThemedDataGridRow}"/>
        <Setter Property="ColumnHeaderStyle" Value="{DynamicResource ThemedDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{DynamicResource ThemedDataGridCell}"/>
    </Style>

    <Style x:Key="ThemedDataGridRow" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThemedDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="ThemedDataGridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ListView / ListBox Item Styles
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ThemedListViewItem" TargetType="ListViewItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="2,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="6"/>
        <Setter Property="Margin" Value="2,2"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentGlowBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ScrollBar — thin, accent-tinted thumb
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ThemedScrollBarThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{StaticResource AccentGlowBrush}"
                            CornerRadius="3"
                            Margin="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         ui:Button Primary — force our indigo accent.
         KEYED (not implicit) so it never replaces WPF-UI's default
         ui:Button template, which would strip toolbar buttons.
         Apply explicitly with Style="{StaticResource PrimaryAccentUiButton}"
         on workspace Primary buttons.
         ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="PrimaryAccentUiButton"
           TargetType="{x:Type ui:Button}"
           BasedOn="{StaticResource {x:Type ui:Button}}">
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Primary">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="#F1EEFF"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Appearance" Value="Primary"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
