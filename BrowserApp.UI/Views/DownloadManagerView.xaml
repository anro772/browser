<!--
  Views/DownloadManagerView.xaml — visual redesign only.

  Bindings preserved verbatim: Downloads{FileName, Status, Progress, TotalBytes, ReceivedBytes,
      DestinationPath, SourceUrl}, ClearCompletedCommand, OpenFileCommand, ShowInFolderCommand.
  Code-behind handler preserved: OnLoaded.

  New bindings / converters introduced — wire these on the VM when convenient:
    - GroupedDownloads (CollectionViewSource grouped by relative day:
        "Today" / "Yesterday" / "Earlier"). If absent, the ListView gracefully
        falls back to flat Downloads via the GroupedDownloads.Source convention.
    - DownloadItemModel.FileTypeBadge   (string: "PDF" | "IMG" | "ZIP" | "FILE")
    - DownloadItemModel.FileTypeBrush   (Brush — see palette in design doc)
    - DownloadItemModel.SourceHost      (string — pulled from SourceUrl)
    - DownloadItemModel.SizeDisplay     ("2.4 MB" or "112 MB / 286 MB" during in-flight)
    - DownloadItemModel.RelativeTime    ("2m", "Yest 4:12pm" …)
    - DownloadItemModel.IsInFlight      (bool — true while downloading)
    - DownloadItemModel.IsCompleted     (bool — for the green check)
    - ChooseDownloadFolderCommand, OpenDownloadsFolderCommand  (empty-state CTAs)
  All existing bindings still work — these are additive, the panel renders without them.
-->
<UserControl x:Class="BrowserApp.UI.Views.DownloadManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:DownloadManagerViewModel}"
             mc:Ignorable="d"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Hover-reveal style for the row "…" action bar. -->
        <Style x:Key="DownloadRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,9"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- File-type chip — colored block with monospace 3-letter label. -->
        <Style x:Key="FileTypeChipStyle" TargetType="Border">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- Download row data template -->
        <DataTemplate x:Key="DownloadRowTemplate">
            <Border Style="{StaticResource DownloadRowStyle}"
                    Cursor="Hand"
                    MouseLeftButtonUp="DownloadRow_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- File-type chip -->
                    <Border Grid.Column="0"
                            Style="{StaticResource FileTypeChipStyle}"
                            Background="{Binding FileTypeBrush, FallbackValue={StaticResource AccentBrush}}"
                            Margin="0,0,10,0">
                        <TextBlock Text="{Binding FileTypeBadge, FallbackValue='FILE'}"
                                   FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="#F5F3FF"/>
                    </Border>

                    <!-- Filename + meta -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- In-flight: animated progress + percentage/size -->
                        <StackPanel Visibility="{Binding IsInFlight, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                            <Border Background="{StaticResource BgElevatedBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                                    CornerRadius="2" Height="4" Margin="0,6,0,4">
                                <Border Background="{StaticResource AccentBrush}" CornerRadius="2"
                                        HorizontalAlignment="Left"
                                        Width="{Binding Progress, Converter={StaticResource PercentToWidth}}"/>
                            </Border>
                            <TextBlock FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <Run Text="{Binding Progress, StringFormat='{}{0}%'}"
                                     FontWeight="SemiBold" Foreground="{StaticResource AccentLightBrush}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SizeDisplay, FallbackValue=''}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding SourceHost, FallbackValue=''}"
                                     Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Completed: check + size + source -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibility}, FallbackValue=Visible}">
                            <ui:SymbolIcon Symbol="Checkmark24" FontSize="11"
                                           Foreground="{StaticResource SuccessBrush}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="10.5" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" · " FontSize="10.5" Margin="2,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SourceHost, FallbackValue=''}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Folder icon button — permanently visible, opens containing folder. -->
                    <ui:Button x:Name="DownloadRowFolder" Grid.Column="2"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Width="32" Height="32" Padding="0" CornerRadius="16"
                               Background="Transparent" BorderThickness="0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               ToolTip="Show in folder"
                               Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                               CommandParameter="{Binding}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Group header — small uppercase accent eyebrow -->
        <Style x:Key="DownloadGroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="Margin" Value="10,8,10,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Downloads"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding Downloads.Count, Mode=OneWay}"/>
                        <Run Text="downloads"/>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding ClearCompletedCommand}"
                           ToolTip="Clear completed downloads"
                           Style="{StaticResource GlassToolbarButtonStyle}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Downloads card -->
        <Border Grid.Row="1" Style="{StaticResource PanelBodyCardStyle}" Padding="6,6,6,8">
            <Grid>
                <!-- Populated: grouped ListView -->
                <ListView ItemsSource="{Binding Downloads}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemTemplate="{StaticResource DownloadRowTemplate}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource DownloadGroupHeaderStyle}"/>
                                        <Border Grid.Column="1" Height="1" Margin="6,0,10,0"
                                                VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4C7C6AEF" Offset="0"/>
                                                    <GradientStop Color="#007C6AEF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty state — inviting illustrated card -->
                <Border CornerRadius="12" Padding="22,18"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Background="{StaticResource BgSurfaceBrush}"
                        Visibility="{Binding Downloads.Count, Converter={StaticResource CountToVisibility}}">
                    <Border.Resources>
                        <Style TargetType="Border">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </Border.Resources>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="14"
                                Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="24"
                                           Foreground="{StaticResource AccentLightBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nothing here yet" FontSize="14" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Files you download will land here.&#x0a;Pick a save location to get started."
                                   FontSize="12" TextAlignment="Center" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" Margin="0,6,0,16"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="Choose folder"
                                       Icon="{ui:SymbolIcon Folder24}"
                                       Appearance="Primary"
                                       Style="{StaticResource PrimaryAccentUiButton}"
                                       Command="{Binding ChooseDownloadFolderCommand}"
                                       Margin="0,0,8,0"/>
                            <ui:Button Content="Open downloads"
                                       Appearance="Secondary"
                                       Command="{Binding OpenDownloadsFolderCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
