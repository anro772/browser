<ui:FluentWindow x:Class="BrowserApp.UI.Views.ChannelDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
        Title="{Binding HeaderName}"
        Height="640" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Channel details"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <!-- Header: avatar + name + owner/sync chips -->
        <Grid Grid.Row="1" Margin="0,16,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="52" Height="52"
                    CornerRadius="8"
                    Margin="0,0,14,0"
                    ClipToBounds="True"
                    Background="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.18}"
                    BorderThickness="1"
                    BorderBrush="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.32}">
                <Grid>
                    <Rectangle Width="5"
                               HorizontalAlignment="Left"
                               Fill="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}"/>
                    <TextBlock Text="{Binding Channel.MonogramDisplay}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="5,0,0,0"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="#"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}"/>
                    <TextBlock Text="{Binding Channel.Name}"
                               FontSize="20" FontWeight="SemiBold"
                               Foreground="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}"/>

                    <Border CornerRadius="9" Padding="7,2" Margin="10,2,0,0"
                            VerticalAlignment="Center"
                            Background="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.16}"
                            Visibility="{Binding Channel.IsJoined, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}"
                                     Style="{StaticResource LivePulseDotStyle}"/>
                            <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Channel.Name, Converter={StaticResource ChannelIdToBrush}}">
                                <Run Text="Live · "/>
                                <Run Text="{Binding Channel.LastSyncDisplay, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="9" Padding="7,2" Margin="6,2,0,0"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSubtleBrush}"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="1"
                            Visibility="{Binding Channel.IsOwner, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Owner" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentLightBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Channel.OwnerDisplay, Mode=OneWay}"
                           FontSize="11.5"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Description -->
        <TextBlock Grid.Row="2"
                   Text="{Binding Channel.Description, Mode=OneWay}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

        <!-- Metadata row -->
        <Border Grid.Row="3"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MEMBERS" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding Channel.MemberCount}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="RULES" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding RuleCountDisplay}" FontSize="15" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="CREATED" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding CreatedDisplay}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="YOU JOINED" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{Binding JoinedDisplay}" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules list -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Rules"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           VerticalAlignment="Center"/>
                <ui:Button Grid.Column="1"
                           x:Name="AddRuleButton"
                           Content="+ Add rule"
                           Appearance="Primary"
                           Style="{StaticResource PrimaryAccentUiButton}"
                           Padding="10,3"
                           Click="AddRuleButton_Click"
                           Visibility="{Binding Channel.IsOwner, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>

            <Border Grid.Row="1"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,2">
                        <ItemsControl ItemsSource="{Binding Channel.RulePreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10,8" Margin="0,2"
                                            Background="Transparent"
                                            BorderThickness="0,0,0,1"
                                            BorderBrush="{StaticResource BorderSubtleBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Channel origin marker -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border Width="3" Height="14" CornerRadius="1.5"
                                                        Background="{StaticResource ChannelOriginBrush}"
                                                        Margin="0,0,4,0"/>
                                                <Grid Width="8" Height="8">
                                                    <Ellipse Width="8" Height="8" Fill="{StaticResource ChannelOriginHaloBrush}"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource ChannelOriginBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Style="{StaticResource LivePulseDotStyle}"/>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Site}"
                                                           FontSize="11"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <ui:SymbolIcon Grid.Column="2"
                                                           Symbol="LockClosed24"
                                                           FontSize="11"
                                                           Margin="0,0,8,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{StaticResource EnforcedOriginBrush}"
                                                           ToolTip="Enforced"
                                                           Visibility="{Binding IsEnforced, Converter={StaticResource BoolToVisibility}}"/>

                                            <ui:Button Grid.Column="3"
                                                       Icon="{ui:SymbolIcon Dismiss24}"
                                                       ToolTip="Remove rule"
                                                       Appearance="Secondary"
                                                       Padding="4"
                                                       Tag="{Binding}"
                                                       Click="DeleteRuleButton_Click"
                                                       Visibility="{Binding DataContext.Channel.IsOwner, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty rules state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding RulesEmptyVisibility}">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="32"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="No rules in this channel yet"
                                   Margin="0,8,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Loading state -->
                    <ui:ProgressRing IsIndeterminate="True" Width="32" Height="32"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Visibility="{Binding Channel.IsLoadingPreview, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Channel-not-joined banner -->
        <Border Grid.Row="5"
                Background="{StaticResource WarningSubtleBrush}"
                BorderBrush="{StaticResource WarningBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,12,0,0"
                Visibility="{Binding NotJoinedVisibility}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Info24" FontSize="14" Margin="0,0,8,0"
                               Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center"/>
                <TextBlock Text="Join this channel to see its rules and sync them locally."
                           FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Bottom action bar -->
        <Grid Grid.Row="6" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Content="Sync now"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Click="SyncNowButton_Click"
                       Margin="0,0,8,0"
                       Visibility="{Binding Channel.IsJoined, Converter={StaticResource BoolToVisibility}}"/>

            <ui:Button Grid.Column="2"
                       Content="Leave channel"
                       Click="LeaveButton_Click"
                       Visibility="{Binding Channel.IsJoined, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </Grid>
</ui:FluentWindow>
