<!--
  Views/PrivacyDashboardView.xaml — visual redesign only.
  Bindings preserved verbatim: PrivacyModeDisplay, PrivacyModeColor, PrivacyModeDescription,
    DetectedThisSession, BlockedThisSession, DataSaved,
    TopBlockedDomains{Domain, Count, Percentage},
    ResourceTypeBreakdown{Type, Count, Percentage},
    ResetStatsCommand, IsLoading.
  Code-behind handlers preserved: OnLoaded, ViewRulesButton_Click, MarketplaceButton_Click, ChannelsButton_Click.
  No new bindings introduced.
-->
<UserControl x:Class="BrowserApp.UI.Views.PrivacyDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="360"
             d:DataContext="{d:DesignInstance vm:PrivacyDashboardViewModel}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <Style x:Key="QuickActionTileStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource FadeInOnLoadModern}">
        <StackPanel Margin="8">

            <!-- Header -->
            <Border Style="{StaticResource PanelHeaderCardStyle}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Privacy Dashboard"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="Your browsing protection overview"
                                   FontSize="12" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ui:Button Grid.Column="1"
                               Icon="{ui:SymbolIcon ArrowReset24}"
                               Command="{Binding ResetStatsCommand}"
                               ToolTip="Reset all statistics"
                               Style="{StaticResource GlassToolbarButtonStyle}"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Hero "Mode" (full-width row) + three stat cards (second row) -->
            <!-- Two rows so long mode labels (e.g. "Standard Mode") don't stretch the stat cards,
                 and so the Saved value (e.g. "668.9 KB") has enough horizontal room to not clip. -->
            <!--
              Clickable mode tile. Visual layers (back to front):
                1. Base linear-gradient accent fill (always visible, subtle).
                2. ModeTileHoverGlow — overlay that fades 0→1 on MouseEnter.
                3. Content grid (icon tile + name/description + dot + chevron).
              Hover effect: 1px lift via TranslateTransform + chevron slides 3px right.
              Animations live in Border.Triggers so children don't accidentally retrigger them.
            -->
            <Border x:Name="ModeTile"
                    Background="{StaticResource BgGlassHeaderBrush}"
                    BorderBrush="{StaticResource AccentBorderBrush}"
                    BorderThickness="1" CornerRadius="12"
                    Margin="0,0,0,6"
                    Cursor="Hand"
                    MouseLeftButtonUp="ModeTile_Click"
                    ToolTip="Open Settings → Privacy Mode">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ModeTileTranslate"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ModeTileTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 To="-1" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ModeTileHoverGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="ModeTileChevronT"
                                                 Storyboard.TargetProperty="X"
                                                 To="3" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ModeTileTranslate"
                                                 Storyboard.TargetProperty="Y"
                                                 To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ModeTileHoverGlow"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="ModeTileChevronT"
                                                 Storyboard.TargetProperty="X"
                                                 To="0" Duration="0:0:0.18">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <!-- Base accent sweep (always on) -->
                    <Border CornerRadius="12" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A7C6AEF" Offset="0"/>
                                <GradientStop Color="#0A7C6AEF" Offset="0.55"/>
                                <GradientStop Color="#007C6AEF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Hover glow overlay (fades in on MouseEnter) -->
                    <Border x:Name="ModeTileHoverGlow" CornerRadius="12"
                            Opacity="0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#387C6AEF" Offset="0"/>
                                <GradientStop Color="#1C7C6AEF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid Margin="14,12,14,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App-icon style square tile -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="11"
                                VerticalAlignment="Center"
                                BorderBrush="#4A7C6AEF" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3F7C6AEF" Offset="0"/>
                                    <GradientStop Color="#147C6AEF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <!-- Inner top-left highlight to give the tile depth -->
                                <Ellipse Width="32" Height="32"
                                         HorizontalAlignment="Left" VerticalAlignment="Top"
                                         Margin="-4" Opacity="0.55" IsHitTestVisible="False">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5"
                                                             RadiusX="0.6" RadiusY="0.6">
                                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="22"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{Binding PrivacyModeColor}"/>
                            </Grid>
                        </Border>

                        <!-- Mode name + description -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PrivacyModeDisplay}"
                                           FontSize="16" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border CornerRadius="4" Padding="6,1,6,2"
                                        Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="#1F7C6AEF"
                                        BorderBrush="#3A7C6AEF" BorderThickness="1">
                                    <TextBlock Text="MODE" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding PrivacyModeDescription}"
                                       FontSize="11" Margin="0,3,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Right: live mode dot + chevron (slides on hover) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Grid Width="9" Height="9" Margin="0,0,8,0">
                                <Ellipse Fill="{Binding PrivacyModeColor}" Opacity="0.35"/>
                                <Ellipse Width="5" Height="5" Fill="{Binding PrivacyModeColor}"/>
                            </Grid>
                            <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                <ui:SymbolIcon.RenderTransform>
                                    <TranslateTransform x:Name="ModeTileChevronT"/>
                                </ui:SymbolIcon.RenderTransform>
                            </ui:SymbolIcon>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Detected -->
                <Border Grid.Column="0" Background="{StaticResource BgGlassHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,12,8,10" Margin="0,0,3,0"
                        ToolTip="Requests evaluated this session.">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                                CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="{Binding DetectedThisSession}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="DETECTED" FontSize="9.5" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Blocked -->
                <Border Grid.Column="1" Background="{StaticResource BgGlassHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,12,8,10" Margin="3,0">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                                CornerRadius="2" Background="{StaticResource ErrorBrush}"/>
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="{Binding BlockedThisSession}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource ErrorBrush}"/>
                            <TextBlock Text="BLOCKED" FontSize="9.5" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Saved -->
                <Border Grid.Column="2" Background="{StaticResource BgGlassHeaderBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10,12,8,10" Margin="3,0,0,0">
                    <Grid>
                        <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                                CornerRadius="2" Background="{StaticResource SuccessBrush}"/>
                        <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="{Binding DataSaved}"
                                       FontSize="20" FontWeight="Bold"
                                       TextTrimming="None"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="SAVED" FontSize="9.5" FontWeight="SemiBold"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Top Blocked Domains — softer rounded bars on red-tinted track -->
            <Border Style="{StaticResource PanelBodyCardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Top Blocked Domains"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="SESSION" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding TopBlockedDomains}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="{Binding Domain}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding Count}"
                                               FontSize="11.5" FontWeight="SemiBold"
                                               Margin="8,0,0,0"
                                               Foreground="{StaticResource ErrorBrush}"/>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2"
                                            Background="#18FCA5A5"
                                            CornerRadius="2" Height="4" Margin="0,5,0,0">
                                        <Border Background="{StaticResource ErrorBrush}"
                                                CornerRadius="2" HorizontalAlignment="Left"
                                                Width="{Binding Percentage, Converter={StaticResource PercentToWidth}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No blocked domains yet"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding TopBlockedDomains.Count, Converter={StaticResource CountToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Request Types — accent-tinted track, 4px bar -->
            <Border Style="{StaticResource PanelBodyCardStyle}" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Request Types"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="BY VOLUME" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ResourceTypeBreakdown}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Type}"
                                               FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Border Grid.Column="1" Background="#187C6AEF"
                                            CornerRadius="2" Height="4" Margin="8,0"
                                            VerticalAlignment="Center">
                                        <Border Background="{StaticResource AccentBrush}"
                                                CornerRadius="2" HorizontalAlignment="Left"
                                                Width="{Binding Percentage, Converter={StaticResource PercentToWidth}}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Count}"
                                               FontSize="11" HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No request data yet"
                               FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding ResourceTypeBreakdown.Count, Converter={StaticResource CountToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Quick Actions — segmented icon+label tile row -->
            <Border Style="{StaticResource PanelBodyCardStyle}" Padding="10">
                <StackPanel>
                    <TextBlock Text="QUICK ACTIONS" FontSize="10" FontWeight="SemiBold"
                               Margin="2,0,0,8"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <Border Background="{StaticResource BgElevatedBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="ViewRulesTile"
                                    CornerRadius="7" Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    MouseLeftButtonUp="ViewRulesButton_Click"
                                    Style="{StaticResource QuickActionTileStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,9">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="16"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rules" FontSize="11.5"
                                               FontWeight="Medium" Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" x:Name="MarketplaceTile"
                                    CornerRadius="7" Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    MouseLeftButtonUp="MarketplaceButton_Click"
                                    Style="{StaticResource QuickActionTileStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,9">
                                    <ui:SymbolIcon Symbol="BuildingShop24" FontSize="16"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Market" FontSize="11.5"
                                               FontWeight="Medium" Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" x:Name="ChannelsTile"
                                    CornerRadius="7" Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    MouseLeftButtonUp="ChannelsButton_Click"
                                    Style="{StaticResource QuickActionTileStyle}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,9">
                                    <ui:SymbolIcon Symbol="PeopleTeam24" FontSize="16"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Center"/>
                                    <TextBlock Text="Channels" FontSize="11.5"
                                               FontWeight="Medium" Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
