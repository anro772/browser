<ui:FluentWindow x:Class="BrowserApp.UI.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding DialogTitle}"
        Height="220" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="{Binding DialogTitle}"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <TextBlock Grid.Row="1"
                   Text="{Binding MessageText}"
                   Style="{StaticResource BodyTextStyle}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="0,12,0,12"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <ui:Button x:Name="CancelBtn"
                       Content="{Binding CancelButtonText}"
                       IsCancel="True"
                       Click="CancelButton_Click"
                       Margin="0,0,8,0"
                       Visibility="{Binding CancelVisibility}"/>
            <ui:Button x:Name="ConfirmBtn"
                       Content="{Binding ConfirmButtonText}"
                       Appearance="Primary"
                       Style="{StaticResource PrimaryAccentUiButton}"
                       IsDefault="True"
                       Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
