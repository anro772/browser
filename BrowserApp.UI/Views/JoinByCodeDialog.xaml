<ui:FluentWindow x:Class="BrowserApp.UI.Views.JoinByCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Join with code"
        Height="320" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Join with code" ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <TextBlock Grid.Row="1"
                   Text="Paste a channel ID and password to join a private or unlisted channel."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14"/>

        <ui:TextBox Grid.Row="2" x:Name="ChannelIdInput"
                    PlaceholderText="Channel ID (e.g. 6bd1bdb4-aee0-4ff2-b2e7-dc836d0a18a8)"
                    Margin="0,0,0,10"/>

        <ui:PasswordBox Grid.Row="3" x:Name="PasswordInput"
                        PlaceholderText="Password"
                        Margin="0,0,0,4"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <ui:Button Content="Cancel"
                       IsCancel="True"
                       Click="CancelButton_Click"
                       Margin="0,0,8,0"/>
            <ui:Button Content="Join"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="JoinButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
