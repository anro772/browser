<ui:FluentWindow x:Class="BrowserApp.UI.Views.MarketplaceRuleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Rule.Name}"
        Height="640" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Marketplace pack"
                     ShowMinimize="False"
                     ShowMaximize="False"
                     ShowClose="True"/>

        <!-- Hero band -->
        <Border Grid.Row="1"
                CornerRadius="10"
                Padding="18,16"
                Margin="0,16,0,0"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#33E6A23C"/>
                    <GradientStop Offset="0.7" Color="#222736"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="64" Height="64"
                        CornerRadius="10"
                        Margin="0,0,18,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="#E6A23C"/>
                            <GradientStop Offset="1" Color="#9CE6A23C"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Fill="#0B0E14"
                          Data="M 0,0 L 20,0 L 20,28 L 10,21 L 0,28 Z"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MARKETPLACE PACK"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MarketOriginBrush}"/>
                    <TextBlock Text="{Binding Rule.Name}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="by " FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding Rule.AuthorUsername}" FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text=" · " FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="12"
                                       Margin="0,0,4,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Rule.DownloadCount}" FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text=" installs" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Site pattern + tags -->
        <Grid Grid.Row="2" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource BgElevatedBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8,3"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Globe24" FontSize="11" Margin="0,0,4,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Rule.Site}"
                               FontSize="11"
                               FontWeight="Medium"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <ItemsControl Grid.Column="1"
                          ItemsSource="{Binding Rule.Tags}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource AccentSubtleBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6,2"
                                Margin="0,0,4,2">
                            <TextBlock Text="{Binding}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentLightBrush}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Description -->
        <Border Grid.Row="3"
                Background="{StaticResource BgElevatedBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DESCRIPTION" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                <TextBlock Text="{Binding Rule.Description}"
                           FontSize="12.5"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- Parsed preview + raw source -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="WHAT IT DOES" FontSize="9.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="0,0,0,8"/>

                <ItemsControl ItemsSource="{Binding ActionBullets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgSurfaceBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Grid.Column="0"
                                                   Symbol="{Binding Icon}"
                                                   FontSize="14"
                                                   Margin="0,1,10,0"
                                                   Foreground="{Binding IconBrush}"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               FontSize="12.5"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="View source (raw JSON)"
                          Margin="0,8,0,0"
                          Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <Border Background="{StaticResource BgPrimaryBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            Margin="0,6,0,0">
                        <TextBox Text="{Binding Rule.RulesJson, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MaxHeight="200"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding CreatedDisplay}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

            <ui:Button Grid.Column="1"
                       x:Name="InstallBtn"
                       Content="Install pack"
                       Icon="{ui:SymbolIcon ArrowDownload24}"
                       Appearance="Primary"
                       Style="{StaticResource PrimaryAccentUiButton}"
                       Padding="14,6"
                       Click="InstallButton_Click"
                       Visibility="{Binding Rule.IsInstalled, Converter={StaticResource BoolToVisibilityInverse}}"/>
            <Border Grid.Column="1"
                    CornerRadius="6"
                    Padding="12,5"
                    Background="#1A34D399"
                    BorderBrush="#4D34D399"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    Visibility="{Binding Rule.IsInstalled, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="#34D399"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="Installed" FontSize="12" FontWeight="SemiBold"
                               Foreground="#34D399" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
