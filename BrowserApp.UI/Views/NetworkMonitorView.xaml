<!--
  Views/NetworkMonitorView.xaml — visual redesign only.

  Bindings preserved verbatim: TotalRequests, BlockedCount, DataSaved,
    IsMonitoringEnabled, SelectedFilter, Requests{ResourceType, Host, ShortUrl,
    StatusCode, FormattedSize, WasBlocked}, SelectedRequest,
    ApplyFilterCommand, ClearAllCommand, ExportToCsvCommand.
  Converters preserved: ResourceTypeToColor, StatusCodeToColor.

  New bindings to wire on the VM:
    - OpenExpandedMonitorCommand   (RelayCommand — opens NetworkMonitorExpandedView)
    - SelectedFilter is used to drive the active-chip styling via a string-equality
      converter ChipActiveConverter (see app dictionary). If you don't have it,
      replace the {StaticResource ChipActiveConverter} with your existing
      equality converter or compute via a DataTrigger on Tag.
-->
<UserControl x:Class="BrowserApp.UI.Views.NetworkMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             xmlns:converters="clr-namespace:BrowserApp.UI.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="360"
             d:DataContext="{d:DesignInstance vm:NetworkMonitorViewModel}">

    <UserControl.Resources>
        <!-- Filter chip — toggled accent fill when SelectedFilter matches Tag.
             Uses your existing FilterChipButtonStyle (chip-shaped Border template). -->
        <Style x:Key="NetFilterChipStyle" TargetType="Button" BasedOn="{StaticResource FilterChipButtonStyle}">
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource ChipActiveConverter}">
                            <Binding RelativeSource="{RelativeSource Self}" Path="CommandParameter"/>
                            <Binding Path="DataContext.SelectedFilter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Network DataGrid row: blocked rows get a left-edge accent stripe + tint. -->
        <Style x:Key="NetRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="0,1">
                            <Grid>
                                <Border x:Name="Stripe" Width="3" HorizontalAlignment="Left"
                                        Margin="2,4" CornerRadius="2"
                                        Background="Transparent"/>
                                <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding WasBlocked}" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#14FCA5A5"/>
                                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource ErrorBrush}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title + monitor toggle + NEW expand-to-modal -->
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Network Monitor"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding TotalRequests, Mode=OneWay}"/>
                        <Run Text="requests captured"/>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Open24}"
                           Command="{Binding OpenExpandedMonitorCommand}"
                           ToolTip="Open expanded view"
                           Style="{StaticResource GlassToolbarButtonStyle}"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ui:ToggleSwitch Grid.Column="2"
                                 IsChecked="{Binding IsMonitoringEnabled}"
                                 ToolTip="Toggle monitoring"
                                 VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Stat tiles -->
        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgGlassHeaderBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,10,8,10" Margin="0,0,4,0">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                            CornerRadius="2" Background="{StaticResource AccentBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding TotalRequests}" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="TOTAL" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource BgGlassHeaderBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,10,8,10" Margin="2,0">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                            CornerRadius="2" Background="{StaticResource ErrorBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding BlockedCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Text="BLOCKED" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource BgGlassHeaderBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="10,10,8,10" Margin="4,0,0,0">
                <Grid>
                    <Border Width="3" HorizontalAlignment="Left" Margin="-10,2,0,2"
                            CornerRadius="2" Background="{StaticResource SuccessBrush}"/>
                    <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                        <TextBlock Text="{Binding DataSaved}" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="SAVED" FontSize="9.5" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Filter chips — accent fill when active -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="8,0,8,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="All"      Style="{StaticResource NetFilterChipStyle}"
                        Command="{Binding ApplyFilterCommand}" CommandParameter="All"/>
                <Button Content="Blocked"  Style="{StaticResource NetFilterChipStyle}"
                        Command="{Binding ApplyFilterCommand}" CommandParameter="Blocked"/>
                <Button Content="3rd Party" Style="{StaticResource NetFilterChipStyle}"
                        Command="{Binding ApplyFilterCommand}" CommandParameter="ThirdParty"/>
                <Button Content="Scripts"  Style="{StaticResource NetFilterChipStyle}"
                        Command="{Binding ApplyFilterCommand}" CommandParameter="Scripts"/>
                <Button Content="Images"   Style="{StaticResource NetFilterChipStyle}"
                        Command="{Binding ApplyFilterCommand}" CommandParameter="Images"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Request list + footer -->
        <Border Grid.Row="3" Style="{StaticResource PanelBodyCardStyle}" Padding="2,2,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid Grid.Row="0"
                          ItemsSource="{Binding Requests}"
                          SelectedItem="{Binding SelectedRequest}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          EnableRowVirtualization="True"
                          Background="Transparent" BorderThickness="0"
                          RowHeight="46" FontSize="12"
                          RowStyle="{StaticResource NetRowStyle}"
                          ColumnHeaderStyle="{StaticResource ThemedDataGridColumnHeader}"
                          CellStyle="{StaticResource ThemedDataGridCell}">
                    <DataGrid.Columns>
                        <!-- Type — distinct colored pill per resource type -->
                        <DataGridTemplateColumn Header="Type" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="6,0"
                                            Background="{Binding ResourceType, Converter={StaticResource ResourceTypeToColor}}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ResourceType}"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#0F1320"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- URL — bold host + lighter path -->
                        <DataGridTemplateColumn Header="URL" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Host}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ShortUrl}" FontSize="10.5" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status — colored dot + code -->
                        <DataGridTemplateColumn Header="Status" Width="56">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                 Fill="{Binding StatusCode, Converter={StaticResource StatusCodeToColor}}"/>
                                        <TextBlock Text="{Binding StatusCode, TargetNullValue='—'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Size" Binding="{Binding FormattedSize}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer with subtle top divider -->
                <Border Grid.Row="1" BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="4,8,4,4">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="Clear"
                                   Icon="{ui:SymbolIcon Delete24}"
                                   Command="{Binding ClearAllCommand}"
                                   Appearance="Secondary"
                                   Margin="0,0,6,0" Padding="10,5"/>
                        <ui:Button Content="Export CSV"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Command="{Binding ExportToCsvCommand}"
                                   Appearance="Primary"
                                   Style="{StaticResource PrimaryAccentUiButton}"
                                   Padding="10,5"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
