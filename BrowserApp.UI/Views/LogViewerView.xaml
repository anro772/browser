<UserControl x:Class="BrowserApp.UI.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:LogViewerViewModel}">

    <UserControl.Resources>
        <!-- Pill toggle: small bordered toggle with semantic-coloured fill when checked. -->
        <Style x:Key="LogLevelTogglePill" TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with controls
             Title row stays on its own line so it never gets clipped by the action buttons,
             which are icon-only (tooltipped) to fit narrow sidebar widths. -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelHeaderCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title + entry count -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Debug Console"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Border Grid.Column="1"
                            Background="{StaticResource BgSurfaceBrush}"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding LogEntries.Count, Mode=OneWay, StringFormat={}{0} entries}"/>
                    </Border>
                </Grid>

                <!-- Icon-only action row (tooltipped) -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <ui:Button Icon="{ui:SymbolIcon FolderOpen24}"
                               Command="{Binding OpenLogFolderCommand}"
                               Appearance="Secondary"
                               ToolTip="Open log folder"
                               Margin="0,0,6,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Copy24}"
                               Command="{Binding CopyAllCommand}"
                               Appearance="Secondary"
                               ToolTip="Copy visible entries"
                               Margin="0,0,6,0"/>
                    <ui:Button Icon="{ui:SymbolIcon Delete24}"
                               Command="{Binding ClearCommand}"
                               Appearance="Secondary"
                               ToolTip="Clear console"/>
                </StackPanel>

                <!-- Search row -->
                <Border Grid.Row="2"
                        Style="{StaticResource AddressBarContainerStyle}"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0"
                                       Symbol="Search24"
                                       FontSize="14"
                                       Margin="6,0,4,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="2,4"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Log display area -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBodyCardStyle}"
                Background="{StaticResource BgPrimaryBrush}"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Filters: level pills + category dropdown + auto-scroll -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource LogLevelTogglePill}"
                                      IsChecked="{Binding ShowDebug}"
                                      Content="DBG"
                                      ToolTip="Debug"/>
                        <ToggleButton Style="{StaticResource LogLevelTogglePill}"
                                      IsChecked="{Binding ShowInfo}"
                                      Content="INF"
                                      ToolTip="Info"/>
                        <ToggleButton Style="{StaticResource LogLevelTogglePill}"
                                      IsChecked="{Binding ShowWarning}"
                                      Content="WRN"
                                      ToolTip="Warning"/>
                        <ToggleButton Style="{StaticResource LogLevelTogglePill}"
                                      IsChecked="{Binding ShowError}"
                                      Content="ERR"
                                      ToolTip="Error"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedCategory}"
                              MinWidth="140"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Filter by category"/>

                    <CheckBox Grid.Column="3"
                              Content="Auto-scroll"
                              IsChecked="{Binding AutoScroll}"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"
                              ToolTip="Automatically scroll to latest log"/>
                </Grid>

                <!-- Log entries -->
                <ScrollViewer Grid.Row="1"
                              x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="2,4">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy entry"
                                                      Command="{Binding DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                            <MenuItem Header="Copy message only"
                                                      Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Timestamp -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding FormattedTime}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Top"
                                                   Padding="2,1,4,0"/>

                                        <!-- Level pill -->
                                        <Border Grid.Column="1"
                                                CornerRadius="3"
                                                Padding="3,1"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Top"
                                                HorizontalAlignment="Left"
                                                BorderThickness="1"
                                                BorderBrush="{Binding LevelColor, Converter={StaticResource StringToBrush}}">
                                            <TextBlock Text="{Binding LevelLabel}"
                                                       FontSize="9.5"
                                                       FontWeight="Bold"
                                                       Foreground="{Binding LevelColor, Converter={StaticResource StringToBrush}}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- Category -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Category}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top"
                                                   Padding="0,1,6,0"/>

                                        <!-- Message -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   FontFamily="{StaticResource AppMonoFontFamily}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Top"
                                                   ToolTip="{Binding Detail}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
