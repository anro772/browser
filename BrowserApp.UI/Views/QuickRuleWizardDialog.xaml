<ui:FluentWindow x:Class="BrowserApp.UI.Views.QuickRuleWizardDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Quick Add Rule"
    Height="420" Width="480"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Quick Add Rule" ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <!-- Step 0: Choose type -->
        <StackPanel Grid.Row="1" x:Name="Step0Panel" Margin="0,8,0,0">
            <TextBlock Text="What would you like to do?"
                       FontSize="16" FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Choose a quick action or open the advanced editor."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,16"/>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="BlockDomain_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ShieldDismiss24" FontSize="22" Foreground="{StaticResource ErrorBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Block a Domain" FontWeight="SemiBold"/>
                        <TextBlock Text="Completely block all requests to a domain" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="BlockAds_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="EyeOff24" FontSize="22" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Block Ads on a Site" FontWeight="SemiBold"/>
                        <TextBlock Text="Block common ad networks and trackers for a site" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="8" Padding="14" Margin="0,0,0,8"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="HideElement_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="LayoutColumnTwoSplitRight24" FontSize="22" Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Hide an Element" FontWeight="SemiBold"/>
                        <TextBlock Text="Hide cookie banners, popups, sidebars, etc." FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgSurfaceBrush}"
                    CornerRadius="8" Padding="14" Margin="0,0,0,0"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                    Cursor="Hand" MouseLeftButtonUp="Advanced_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Code24" FontSize="22" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Advanced Editor" FontWeight="SemiBold"/>
                        <TextBlock Text="Full control over URL patterns, CSS/JS injection" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Step 1: Enter details -->
        <Grid Grid.Row="1" x:Name="Step1Panel" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="StepTitleText"
                       FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" x:Name="StepDescriptionText"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <TextBlock Text="Domain / Site" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="DomainInput"
                            PlaceholderText="e.g. example.com"
                            Text="{Binding InputDomain, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" x:Name="DescriptionPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="What to hide" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="DescriptionInput"
                            PlaceholderText="e.g. cookie banner, popup, sidebar..."
                            Text="{Binding InputDescription, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="ErrorText"
                       Foreground="{StaticResource ErrorBrush}"
                       Visibility="Collapsed"
                       Margin="0,0,0,8"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Back" Click="BackButton_Click" Margin="0,0,8,0"/>
                <ui:Button Content="Create Rule" Appearance="Primary" Click="CreateButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
