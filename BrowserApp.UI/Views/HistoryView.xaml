<UserControl x:Class="BrowserApp.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="350"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             Loaded="OnLoaded">

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Style="{StaticResource PanelHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Browsing History"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0">
                        <Run Text="{Binding HistoryEntries.Count, Mode=OneWay}"/>
                        <Run Text="entries"/>
                    </TextBlock>
                </StackPanel>

                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding ClearHistoryCommand}"
                           ToolTip="Clear all history"
                           Appearance="Secondary"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search Box -->
        <Border Grid.Row="1"
                Style="{StaticResource PanelBodyCardStyle}"
                Margin="8,0,8,8"
                Padding="8">
            <ui:TextBox PlaceholderText="Search history..."
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"/>
        </Border>

        <!-- History List -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelBodyCardStyle}">
            <Grid>
                <!-- Loading Indicator -->
                <ui:ProgressRing IsIndeterminate="True"
                                 Width="40"
                                 Height="40"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <!-- History ListView (grouped by day, host avatar + title + time per row) -->
                <ListView ItemsSource="{Binding GroupedHistory}"
                          SelectedItem="{Binding SelectedEntry}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="Transparent"
                          BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityInverse}}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,8"
                                    Cursor="Hand"
                                    Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftDoubleClick"
                                                  Command="{Binding DataContext.NavigateToEntryAsyncCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                  CommandParameter="{Binding}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Host avatar (poor-man's favicon: first letter of host on accent chip) -->
                                    <Border Grid.Column="0"
                                            Width="28" Height="28"
                                            CornerRadius="14"
                                            Background="{StaticResource AccentSubtleBrush}"
                                            BorderBrush="{StaticResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            VerticalAlignment="Top"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding HostInitial}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title + host -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Url}"/>
                                        <TextBlock Text="{Binding Host}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Time -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeLabel}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}"/>
                    </ListView.ItemContainerStyle>

                    <!-- Day section headers -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgElevatedBrush}"
                                            Padding="10,4"
                                            Margin="0,4,0,2"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="{Binding HistoryEntries.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:SymbolIcon Symbol="History24"
                                   FontSize="48"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="No history yet"
                               FontSize="14"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <TextBlock Text="Visited pages will appear here"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
