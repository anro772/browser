<!--
  Views/HistoryView.xaml — visual redesign + clickability fix.

  Bindings preserved verbatim: HistoryEntries{HostInitial, DisplayTitle, Host, Url, TimeLabel},
    GroupedHistory, SelectedEntry, SearchQuery, IsLoading,
    NavigateToEntryCommand, ClearHistoryCommand.
  Code-behind handler preserved: OnLoaded.

  CLICKABILITY BUG FIX: MouseBinding gesture changed from LeftDoubleClick → LeftClick.
  Single click on a row now invokes NavigateToEntryCommand.

  New bindings to wire on the VM (additive — view degrades cleanly if missing):
    - HistoryEntryDisplay.HostBrush  (Brush — stable hash of Host. Suggested palette:
        #9B8AFB violet, #93C5FD blue, #5EEAD4 teal, #FCD34D amber, #F0708A rose,
        #6EE7B7 green; fall back to AccentBrush. Compute once when the entry is
        materialized so the same host always lands on the same hue.)
    - OpenInNewTabCommand   (RelayCommand<HistoryEntryDisplay>)
    - CopyUrlCommand        (RelayCommand<HistoryEntryDisplay>)
    - DeleteEntryCommand    (RelayCommand<HistoryEntryDisplay>)
  Where a command isn't yet wired, the menu item simply no-ops.
-->
<UserControl x:Class="BrowserApp.UI.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:BrowserApp.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="360"
             d:DataContext="{d:DesignInstance vm:HistoryViewModel}"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- Row container — clean hover + accent left stripe.
             Overrides ThemedListViewItem to add the stripe via a template. -->
        <Style x:Key="HistoryRowItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="ItemBorder" Background="Transparent"
                                CornerRadius="8" Padding="8,8">
                            <Grid>
                                <Border x:Name="Stripe" Width="2" HorizontalAlignment="Left"
                                        Margin="-4,3" CornerRadius="2" Background="Transparent"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                <Setter TargetName="Stripe" Property="Background" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Browsing History"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock FontSize="12" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding HistoryEntries.Count, Mode=OneWay}"/>
                        <Run Text="entries"/>
                    </TextBlock>
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Icon="{ui:SymbolIcon Delete24}"
                           Command="{Binding ClearHistoryCommand}"
                           ToolTip="Clear all history"
                           Style="{StaticResource GlassToolbarButtonStyle}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Search -->
        <Border Grid.Row="1" Style="{StaticResource PanelBodyCardStyle}" Margin="8,0,8,8" Padding="8">
            <ui:TextBox PlaceholderText="Search history..."
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"/>
        </Border>

        <!-- Grouped list -->
        <Border Grid.Row="2" Style="{StaticResource PanelBodyCardStyle}" Padding="4,2,4,8">
            <Grid>
                <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                <ListView ItemsSource="{Binding GroupedHistory}"
                          SelectedItem="{Binding SelectedEntry}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ItemContainerStyle="{StaticResource HistoryRowItemStyle}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityInverse}}">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonUp="HistoryRow_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Host avatar (hash-derived hue via HostBrush; falls back to AccentSubtle) -->
                                    <Border Grid.Column="0"
                                            Width="30" Height="30" CornerRadius="15"
                                            Background="{Binding HostBrush, FallbackValue={StaticResource AccentSubtleBrush}}"
                                            BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding HostInitial}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#F8FAFC"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Title + host -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}"
                                                   FontSize="13" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Url}"/>
                                        <TextBlock Text="{Binding Host}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>

                                    <!-- Time (hidden on hover) -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TimeLabel}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=Row, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Hover-revealed overflow menu. Tag carries the VM so the ContextMenu can reach commands. -->
                                    <ui:Button x:Name="HistoryRowMore" Grid.Column="2"
                                               Icon="{ui:SymbolIcon MoreHorizontal24}"
                                               Width="28" Height="28" Padding="0" CornerRadius="14"
                                               Background="Transparent" BorderThickness="0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Click="HistoryRowMore_Click"
                                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               ToolTip="More">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=Row, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                        <ui:Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Open"
                                                          Command="{Binding PlacementTarget.Tag.NavigateToEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Open in new tab"
                                                          Command="{Binding PlacementTarget.Tag.OpenInNewTabCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <MenuItem Header="Copy URL"
                                                          Command="{Binding PlacementTarget.Tag.CopyUrlCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                <Separator/>
                                                <MenuItem Header="Delete entry"
                                                          Command="{Binding PlacementTarget.Tag.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                            </ContextMenu>
                                        </ui:Button.ContextMenu>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>

                    <!-- Day group headers — small uppercase, accent-tinted, sticky-feeling. -->
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,8,2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentLightBrush}"
                                                   Padding="6,2"/>
                                        <Border Grid.Column="1" Height="1" Margin="8,0,8,0"
                                                VerticalAlignment="Center">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4C7C6AEF" Offset="0"/>
                                                    <GradientStop Color="#007C6AEF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>
                </ListView>

                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HistoryEntries.Count, Converter={StaticResource CountToVisibility}}">
                    <ui:SymbolIcon Symbol="History24" FontSize="48"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="No history yet" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="Visited pages will appear here" FontSize="12"
                               HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
