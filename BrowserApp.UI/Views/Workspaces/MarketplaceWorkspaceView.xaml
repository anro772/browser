<UserControl x:Class="BrowserApp.UI.Views.Workspaces.MarketplaceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:BrowserApp.UI.Controls"
             Loaded="MarketplaceWorkspaceView_Loaded">

    <UserControl.Resources>
        <Style x:Key="MarketCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <!-- Anchor each card to the top of its UniformGrid cell so cards size to
                 their content, not to the tallest sibling. Sparse rows look right. -->
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Marketplace"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Public rule packs. One-click install — frozen at install."
                           FontSize="12"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="Refresh"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding LoadRulesCommand}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- SEARCH + COUNT -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search packs by name, description, or author…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,12,0"/>

            <Border Grid.Column="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="{StaticResource MarketOriginBrush}"
                          Data="M 0,0 L 8,0 L 8,12 L 4,9 L 0,12 Z"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TotalRules}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text=" packs" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FEATURED HERO — design's Editor's Pick. Bound to the first pack; hidden when empty. -->
        <ContentControl Grid.Row="2"
                        Content="{Binding Rules[0]}"
                        Margin="0,0,0,16">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Rules.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Padding="20,18"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#33E6A23C"/>
                                <GradientStop Offset="0.6" Color="#222736"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 64px gradient icon plate -->
                            <Border Grid.Column="0"
                                    Width="64" Height="64"
                                    CornerRadius="10"
                                    Margin="0,0,18,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#E6A23C"/>
                                        <GradientStop Offset="1" Color="#9CE6A23C"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#0B0E14"
                                      Data="M 0,0 L 20,0 L 20,28 L 10,21 L 0,28 Z"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name + meta -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="EDITOR'S PICK"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MarketOriginBrush}"/>
                                    <TextBlock Text=" · " FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="Static after install"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="by " FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding AuthorUsername}" FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text=" · " FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding DownloadCount}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text=" installs" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ui:Button Grid.Column="2"
                                       Content="Install pack"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Style="{StaticResource PrimaryAccentUiButton}"
                                       Appearance="Primary"
                                       VerticalAlignment="Center"
                                       Padding="14,6"
                                       Command="{Binding DataContext.InstallRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverse}}"/>
                            <Border Grid.Column="2"
                                    CornerRadius="6"
                                    Padding="12,5"
                                    Background="#1A34D399"
                                    BorderBrush="#4D34D399"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="#34D399"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Installed" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#34D399" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- CARDS GRID -->
        <Grid Grid.Row="4">
            <controls:WorkspaceEmptyState
                IconSymbol="BookmarkMultiple24"
                Eyebrow="PUBLIC PACKS"
                EyebrowBrush="{StaticResource MarketOriginBrush}"
                EyebrowSubtleBrush="{StaticResource BgSurfaceBrush}"
                Headline="No packs to show"
                Body="Marketplace packs are public, one-click installs. Frozen at install — your local copy doesn't auto-update."
                PrimaryCtaText="Refresh"
                PrimaryCtaClicked="MarketplaceEmpty_Refresh"
                Visibility="{Binding Rules.Count, Converter={StaticResource CountToVisibility}}"
                Panel.ZIndex="10"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MarketCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: bookmark glyph + name + author -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="8"
                                                Background="#1AE6A23C"
                                                BorderBrush="#3DE6A23C"
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Path Fill="{StaticResource MarketOriginBrush}"
                                                  Data="M 0,0 L 14,0 L 14,20 L 7,15 L 0,20 Z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="by " FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding AuthorUsername}"
                                                           FontSize="11"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description (compact — design drops the site code-line) -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               TextTrimming="WordEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,10"/>

                                    <!-- Footer: installs · install button -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                                           FontSize="12"
                                                           Margin="0,0,4,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadCount}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text=" installs" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Install button (hidden once installed; replaced with a chip) -->
                                        <ui:Button Grid.Column="1"
                                                   Content="Install"
                                                   Style="{StaticResource PrimaryAccentUiButton}"
                                                   Appearance="Primary"
                                                   Padding="12,4"
                                                   Command="{Binding DataContext.InstallRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                        <Border Grid.Column="1"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                Background="#1A34D399"
                                                BorderBrush="#4D34D399"
                                                BorderThickness="1"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="#34D399"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#34D399" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{StaticResource BgPrimaryBrush}"
                    Opacity="0.82"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True"/>
            </Border>
        </Grid>

        <!-- STATUS -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
