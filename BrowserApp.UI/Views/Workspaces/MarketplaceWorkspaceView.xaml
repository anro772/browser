<UserControl x:Class="BrowserApp.UI.Views.Workspaces.MarketplaceWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:BrowserApp.UI.Controls"
             x:Name="MarketRoot"
             Loaded="MarketplaceWorkspaceView_Loaded">

    <UserControl.Resources>
        <Style x:Key="MarketCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <!-- Fixed height so cards in the same row line up regardless of how long the
                 description or tag set is. Inner content stays anchored top via the grid;
                 the description's MaxHeight+WordEllipsis already truncates overflow. -->
            <Setter Property="Height" Value="186"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Marketplace"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Public rule packs. One-click install — frozen at install."
                           FontSize="12"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <ui:Button Grid.Column="1"
                       Content="Refresh"
                       Icon="{ui:SymbolIcon ArrowSync24}"
                       Command="{Binding LoadRulesCommand}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- SEARCH + COUNT -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search packs by name, description, or author…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,12,0"/>

            <Border Grid.Column="1"
                    Background="{StaticResource BgSurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="10,4"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Fill="{StaticResource MarketOriginBrush}"
                          Data="M 0,0 L 8,0 L 8,12 L 4,9 L 0,12 Z"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding TotalRules}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text=" packs" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FEATURED HERO — most-installed pack drives this; collapses when no rules loaded. -->
        <ContentControl Grid.Row="2"
                        Content="{Binding TopRule}"
                        Margin="0,0,0,16">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TopRule}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Padding="20,18"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Offset="0" Color="#33E6A23C"/>
                                <GradientStop Offset="0.6" Color="#222736"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 64px gradient icon plate -->
                            <Border Grid.Column="0"
                                    Width="64" Height="64"
                                    CornerRadius="10"
                                    Margin="0,0,18,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Offset="0" Color="#E6A23C"/>
                                        <GradientStop Offset="1" Color="#9CE6A23C"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Fill="#0B0E14"
                                      Data="M 0,0 L 20,0 L 20,28 L 10,21 L 0,28 Z"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <!-- Name + meta -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="EDITOR'S PICK"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MarketOriginBrush}"/>
                                    <TextBlock Text=" · " FontSize="10"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="Static after install"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                            Visibility="{Binding HasServerMetadata, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="by " FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding AuthorUsername}" FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text=" · " FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding DownloadCount}" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text=" installs" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <ui:Button Grid.Column="2"
                                       Content="Install pack"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Style="{StaticResource PrimaryAccentUiButton}"
                                       Appearance="Primary"
                                       VerticalAlignment="Center"
                                       Padding="14,6"
                                       Command="{Binding DataContext.InstallRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                       CommandParameter="{Binding}"
                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverse}}"/>
                            <Border Grid.Column="2"
                                    CornerRadius="6"
                                    Padding="12,5"
                                    Background="#1A34D399"
                                    BorderBrush="#4D34D399"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="12" Foreground="#34D399"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Installed" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#34D399" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

        <!-- TAG CHIP STRIP -->
        <Grid Grid.Row="3" Margin="0,0,0,10"
              Visibility="{Binding AvailableTags.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="TAGS"
                       FontSize="10" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <ScrollViewer Grid.Column="1"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding AvailableTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding}"
                                    Tag="{Binding}"
                                    Click="TagChip_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FilterChipButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <MultiBinding Converter="{StaticResource StringEqToBool}">
                                                        <Binding Path="."/>
                                                        <Binding Path="DataContext.SelectedTag"
                                                                 RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </DataTrigger.Binding>
                                                <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentLightBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button Grid.Column="2"
                    Content="Clear"
                    Style="{StaticResource FilterChipButtonStyle}"
                    Command="{Binding ClearTagFilterCommand}"
                    Visibility="{Binding SelectedTag, Converter={StaticResource NullToVisibility}}"/>
        </Grid>

        <!-- CARDS GRID — banner stacks above cards via internal row definitions.
             Previously these were two separate sibling Grids both at Grid.Row="4",
             which caused the banner to overlap the cards once both could be visible
             simultaneously (offline-with-local-packs state). -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Offline banner -->
            <Border Grid.Row="0"
                    Background="{StaticResource WarningSubtleBrush}"
                    BorderBrush="{StaticResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="CloudOff24" FontSize="14"
                                   Margin="0,0,8,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding StatusMessage}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ui:Button Grid.Column="2"
                               Content="Retry"
                               Command="{Binding LoadRulesCommand}"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
            <controls:WorkspaceEmptyState
                IconSymbol="BookmarkMultiple24"
                Eyebrow="PUBLIC PACKS"
                EyebrowBrush="{StaticResource MarketOriginBrush}"
                EyebrowSubtleBrush="{StaticResource BgSurfaceBrush}"
                Headline="No packs to show"
                Body="Marketplace packs are public, one-click installs. Frozen at install — your local copy doesn't auto-update."
                PrimaryCtaText="Refresh"
                PrimaryCtaClicked="MarketplaceEmpty_Refresh"
                Visibility="{Binding Rules.Count, Converter={StaticResource CountToVisibility}}"
                Panel.ZIndex="10"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MarketCardStyle}"
                                    Cursor="Hand"
                                    Tag="{Binding}"
                                    MouseLeftButtonUp="MarketCard_MouseLeftButtonUp">
                                <Border.ToolTip>
                                    <ToolTip Content="Click to view details and preview"/>
                                </Border.ToolTip>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: bookmark glyph + name + author -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                CornerRadius="8"
                                                BorderThickness="1"
                                                Margin="0,0,10,0">
                                            <Border.Style>
                                                <!-- Non-recommended cards get a neutral accent so the
                                                     gold bookmark stays exclusive to the editor's pick. -->
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                            <Setter Property="Background" Value="#1AE6A23C"/>
                                                            <Setter Property="BorderBrush" Value="#3DE6A23C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Path Data="M 0,0 L 14,0 L 14,20 L 7,15 L 0,20 Z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource AccentLightBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRecommended}" Value="True">
                                                                <Setter Property="Fill" Value="{StaticResource MarketOriginBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="by " FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                                <Button Padding="0" Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand"
                                                        Tag="{Binding AuthorUsername}"
                                                        Click="AuthorChip_Click"
                                                        ToolTip="Filter by this author">
                                                    <TextBlock Text="{Binding AuthorUsername}"
                                                               FontSize="11"
                                                               FontWeight="Medium"
                                                               Foreground="{StaticResource AccentLightBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Description (compact — design drops the site code-line) -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Description}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"
                                               TextTrimming="WordEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,0,0,8"/>

                                    <!-- Tag chips -->
                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Tags}"
                                                  Margin="0,0,0,8"
                                                  Visibility="{Binding Tags.Length, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource BgElevatedBrush}"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="6,1"
                                                        Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Footer: installs · install button -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding HasServerMetadata, Converter={StaticResource BoolToVisibility}}">
                                            <ui:SymbolIcon Symbol="ArrowDownload24"
                                                           FontSize="12"
                                                           Margin="0,0,4,0"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadCount}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text=" installs" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- Install button (hidden once installed; replaced with a chip) -->
                                        <ui:Button Grid.Column="1"
                                                   Content="Install"
                                                   Style="{StaticResource PrimaryAccentUiButton}"
                                                   Appearance="Primary"
                                                   Padding="12,4"
                                                   Command="{Binding DataContext.InstallRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibilityInverse}}"/>
                                        <Border Grid.Column="1"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                Background="#1A34D399"
                                                BorderBrush="#4D34D399"
                                                BorderThickness="1"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Checkmark24" FontSize="11" Foreground="#34D399"
                                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Installed" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="#34D399" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button HorizontalAlignment="Center"
                        Margin="0,8,0,16"
                        Padding="20,8"
                        Background="{StaticResource BgSurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="12" Foreground="{StaticResource AccentLightBrush}">
                            <Run Text="Load more — "/>
                            <Run Text="{Binding Rules.Count, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding ServerTotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Button>
                </StackPanel>
            </ScrollViewer>

            <Border Background="{StaticResource BgPrimaryBrush}"
                    Opacity="0.82"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True"/>
            </Border>
            </Grid>
        </Grid>

        <!-- STATUS -->
        <TextBlock Grid.Row="5"
                   Text="{Binding StatusMessage}"
                   FontSize="11"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
