<UserControl x:Class="BrowserApp.UI.Views.Workspaces.ChannelsWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:BrowserApp.UI.Controls"
             Loaded="ChannelsWorkspaceView_Loaded">

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Channels"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Private rule channels. Rules sync live from the channel owner — enforced rules can't be disabled locally."
                           FontSize="12"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Refresh" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding LoadChannelsCommand}"
                           Appearance="Secondary"/>
                <ui:Button Content="Sync All" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Command="{Binding SyncNowCommand}"
                           Style="{StaticResource PrimaryAccentUiButton}"
                           Appearance="Primary"/>
                <ui:Button Content="Join with code" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon Key24}"
                           Command="{Binding JoinByCodeCommand}"
                           Appearance="Secondary"
                           ToolTip="Join a private or unlisted channel using its ID + password"/>
                <ui:Button Content="+ New Channel"
                           Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding ShowCreateDialogCommand}"
                           Appearance="Secondary"/>
            </StackPanel>
        </Grid>

        <!-- Row 1: Search bar + Joined only checkbox -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search channels..."
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,12,0"/>
            <CheckBox Grid.Column="1" Content="Joined only"
                      IsChecked="{Binding ShowJoinedOnly}"
                      VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Grid>

        <!-- Row 2: Channel list (or empty state) -->
        <Grid Grid.Row="2">
            <!-- Empty state — explains channels = team/community feeds, with a "Skip" off-ramp for solo users. -->
            <controls:WorkspaceEmptyState
                IconSymbol="PeopleTeam24"
                Eyebrow="TEAM CHANNELS"
                EyebrowBrush="{StaticResource ChannelOriginBrush}"
                EyebrowSubtleBrush="{StaticResource BgSurfaceBrush}"
                Headline="No channels yet"
                Body="Channels are private rule packs from a team or community. Rules sync live from the owner. Paste an invite code — or skip if you're solo."
                PrimaryCtaText="Refresh"
                SecondaryCtaText="Skip for now"
                PrimaryCtaClicked="ChannelsEmpty_Refresh"
                SecondaryCtaClicked="ChannelsEmpty_Skip"
                Visibility="{Binding Channels.Count, Converter={StaticResource CountToVisibility}}"
                Panel.ZIndex="10"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Channels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgSurfaceBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                Padding="12,10"
                                Cursor="Hand"
                                Tag="{Binding}"
                                MouseLeftButtonUp="ChannelCard_MouseLeftButtonUp">
                            <Border.ToolTip>
                                <ToolTip Content="Click to view rules and details"/>
                            </Border.ToolTip>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stripe + monogram avatar in the channel hue -->
                                <Border Grid.Column="0"
                                        Width="44" Height="44"
                                        CornerRadius="6"
                                        Margin="0,0,12,0"
                                        ClipToBounds="True"
                                        Background="{Binding Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.18}"
                                        BorderThickness="1"
                                        BorderBrush="{Binding Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.32}">
                                    <Grid>
                                        <Rectangle Width="4"
                                                   HorizontalAlignment="Left"
                                                   Fill="{Binding Name, Converter={StaticResource ChannelIdToBrush}}"/>
                                        <TextBlock Text="{Binding MonogramDisplay}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Margin="4,0,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Name, Converter={StaticResource ChannelIdToBrush}}"/>
                                    </Grid>
                                </Border>

                                <!-- Name + chips + single-line meta -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="#" FontSize="14" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Name, Converter={StaticResource ChannelIdToBrush}}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding Name, Converter={StaticResource ChannelIdToBrush}}"/>

                                        <!-- Live · Nm ago chip -->
                                        <Border CornerRadius="9" Padding="7,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding Name, Converter={StaticResource ChannelIdToBrush}, ConverterParameter=0.16}"
                                                Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{Binding Name, Converter={StaticResource ChannelIdToBrush}}"
                                                         Style="{StaticResource LivePulseDotStyle}"/>
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{Binding Name, Converter={StaticResource ChannelIdToBrush}}">
                                                    <Run Text="Live · "/>
                                                    <Run Text="{Binding LastSyncDisplay, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Owner chip -->
                                        <Border CornerRadius="9" Padding="7,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource AccentSubtleBrush}"
                                                BorderBrush="{StaticResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                Visibility="{Binding IsOwner, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="Owner" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentLightBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Single-line description + stats -->
                                    <TextBlock FontSize="11.5" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{Binding Description, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CreatedTooltip}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <Run Text="{Binding MetaLine, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Trailing action cluster -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Content="Join"
                                               Style="{StaticResource PrimaryAccentUiButton}"
                                               Appearance="Primary"
                                               Padding="14,4"
                                               Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibilityInverse}}"
                                               Command="{Binding DataContext.JoinChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>

                                    <ui:Button Content="Sync"
                                               Style="{StaticResource PrimaryAccentUiButton}"
                                               Appearance="Primary"
                                               Icon="{ui:SymbolIcon ArrowSync24}"
                                               Padding="10,4"
                                               Margin="0,0,6,0"
                                               Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DataContext.SyncChannelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               CommandParameter="{Binding}"/>
                                    <ui:Button Icon="{ui:SymbolIcon MoreHorizontal24}"
                                               Appearance="Secondary"
                                               ToolTip="More"
                                               Tag="{Binding}"
                                               Click="ChannelMore_Click"
                                               Visibility="{Binding IsJoined, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Row 3: Status bar -->
        <Border Grid.Row="3" Background="{StaticResource BgElevatedBrush}" Padding="16,8" Margin="0,12,0,0"
                CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <TextBlock Grid.Column="1"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Showing "/>
                    <Run Text="{Binding Channels.Count, Mode=OneWay}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalChannels, Mode=OneWay}"/>
                </TextBlock>
                <ui:ProgressRing Grid.Column="2"
                                 IsIndeterminate="True" Width="16" Height="16"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
