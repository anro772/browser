<UserControl x:Class="BrowserApp.UI.Views.Workspaces.RulesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:BrowserApp.UI.Controls"
             Loaded="RulesWorkspaceView_Loaded">

    <UserControl.Resources>
        <!-- Dense table-style rows (per design): hairline divider, no rounded corners. -->
        <Style x:Key="RuleRowStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BgSurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small chip used in the filter row -->
        <Style x:Key="FilterChipStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER: title + rich substats on the left, Export + New Rule on the right -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Rules"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding EnabledRules}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Text=" active" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text=" · " FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding DisabledRules, Mode=OneWay}"/>
                        <Run Text=" disabled"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:DropDownButton Content="Templates" Margin="0,0,8,0" Icon="{ui:SymbolIcon BookmarkMultiple24}">
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem Header="Auto-Dismiss Cookie Banners" Command="{Binding LoadTemplateCommand}" CommandParameter="cookie-banners"/>
                            <MenuItem Header="Remove Sticky Headers" Command="{Binding LoadTemplateCommand}" CommandParameter="remove-sticky-headers"/>
                            <MenuItem Header="Force Dark Mode" Command="{Binding LoadTemplateCommand}" CommandParameter="force-dark-mode"/>
                            <Separator/>
                            <MenuItem Header="Privacy Headers" Command="{Binding LoadTemplateCommand}" CommandParameter="privacy-headers"/>
                            <MenuItem Header="Enterprise Content Policy" Command="{Binding LoadTemplateCommand}" CommandParameter="content-policy"/>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
                <ui:Button Content="Advanced" Icon="{ui:SymbolIcon Code24}"
                           Command="{Binding CreateRuleCommand}"
                           Margin="0,0,8,0"/>
                <ui:Button Content="New rule" Icon="{ui:SymbolIcon Add24}"
                           Command="{Binding QuickAddRuleCommand}"
                           Style="{StaticResource PrimaryAccentUiButton}"
                           Appearance="Primary"/>
            </StackPanel>
        </Grid>

        <!-- SEARCH + FILTER CHIPS -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search rules…"
                        Icon="{ui:SymbolIcon Search24}"
                        Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,0,12,0"/>

            <!-- Filter chips reuse the same style; show source legend + total count -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource FilterChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding TotalRules}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text=" rules" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterChipStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                 Fill="{StaticResource SuccessBrush}"/>
                        <TextBlock Text="{Binding EnabledRules}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock Text=" active" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- COLUMN HEADERS — uppercase, tracking, design-system 10px -->
        <Grid Grid.Row="2" Margin="8,4,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="2" Text="RULE"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="2,0,0,0"/>
            <TextBlock Grid.Column="3" Text="SOURCE"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Grid.Column="4" Text="HITS / 7D"
                       FontSize="10" FontWeight="SemiBold"
                       TextAlignment="Right"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            <TextBlock Grid.Column="5" Text="UPDATED"
                       FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- ROWS -->
        <Grid Grid.Row="3">
            <!-- Empty state overlay -->
            <controls:WorkspaceEmptyState x:Name="RulesEmptyState"
                                          IconSymbol="Shield24"
                                          Eyebrow="YOUR RULES"
                                          EyebrowBrush="{StaticResource LocalOriginBrush}"
                                          EyebrowSubtleBrush="{StaticResource BgSurfaceBrush}"
                                          Headline="No rules yet"
                                          Body="Add your own rule, or install a public pack from Marketplace. Your active set lives in this profile."
                                          PrimaryCtaText="New rule"
                                          SecondaryCtaText="Browse Marketplace"
                                          PrimaryCtaClicked="RulesEmpty_Primary"
                                          SecondaryCtaClicked="RulesEmpty_Secondary"
                                          Visibility="{Binding Rules.Count, Converter={StaticResource CountToVisibility}}"
                                          Panel.ZIndex="10"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RuleRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 1 · Source marker (slate dot / amber bookmark / channel stripe+pulse) -->
                                    <Grid Grid.Column="0" Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{StaticResource LocalOriginBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Visibility="{Binding Source, Converter={StaticResource StringEqToVis}, ConverterParameter=local|template|ai}"/>
                                        <Path Fill="{StaticResource MarketOriginBrush}"
                                              Data="M 0,0 L 10,0 L 10,15 L 5,11 L 0,15 Z"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Visibility="{Binding Source, Converter={StaticResource StringEqToVis}, ConverterParameter=marketplace}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Visibility="{Binding Source, Converter={StaticResource StringEqToVis}, ConverterParameter=channel}">
                                            <Border Width="3" Height="14" CornerRadius="1.5"
                                                    Background="{StaticResource ChannelOriginBrush}"
                                                    Margin="0,0,4,0"/>
                                            <Grid Width="8" Height="8">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource ChannelOriginHaloBrush}"/>
                                                <Ellipse Width="5" Height="5" Fill="{StaticResource ChannelOriginBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Style="{StaticResource LivePulseDotStyle}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 2 · Toggle (disabled when enforced) — scaled to design density -->
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                     Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     CommandParameter="{Binding}"
                                                     IsEnabled="{Binding IsEnforced, Converter={StaticResource InverseBoolConverter}}"
                                                     RenderTransformOrigin="0.5,0.5"
                                                     HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <ui:ToggleSwitch.RenderTransform>
                                            <ScaleTransform ScaleX="0.78" ScaleY="0.78"/>
                                        </ui:ToggleSwitch.RenderTransform>
                                    </ui:ToggleSwitch>

                                    <!-- 3 · Rule name (+ lock if enforced) -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,12,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Description}"
                                                   VerticalAlignment="Center"/>
                                        <ui:SymbolIcon Symbol="LockClosed24"
                                                       FontSize="11"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource EnforcedOriginBrush}"
                                                       ToolTip="Enforced — can't disable"
                                                       Visibility="{Binding IsEnforced, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <!-- 4 · Source label (colored to match the marker) -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding SourceDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource LocalOriginBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Source}" Value="marketplace">
                                                        <Setter Property="Foreground" Value="{StaticResource MarketOriginBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Source}" Value="channel">
                                                        <Setter Property="Foreground" Value="{StaticResource ChannelOriginBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 5 · Hits / 7d ("—" placeholder until per-rule counts ship) -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding HitsDisplay}"
                                               FontSize="12"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                    <!-- 6 · Updated (relative time) -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding UpdatedDisplay}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                                    <!-- 7 · More menu (edit / publish / delete tucked away) -->
                                    <ui:Button Grid.Column="6"
                                               ToolTip="More"
                                               Padding="4"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Click="RuleMore_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="MoreHorizontal24"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Background="{StaticResource BgPrimaryBrush}"
                    Opacity="0.82"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True"/>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="4"
                Background="{StaticResource BgElevatedBrush}"
                CornerRadius="6"
                Padding="12,6"
                Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,6,0"
                             Fill="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="Active profile rules · synced with this device"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                    <Run Text="Showing "/>
                    <Run Text="{Binding Rules.Count, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Run Text=" of "/>
                    <Run Text="{Binding TotalRules, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
