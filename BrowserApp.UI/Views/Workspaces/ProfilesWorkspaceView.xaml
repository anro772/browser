<UserControl x:Class="BrowserApp.UI.Views.Workspaces.ProfilesWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- Compact profile row container — matches design density. -->
        <Style x:Key="ProfileRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource ThemedListViewItem}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Browser Profiles"
                           Style="{StaticResource TitleTextStyle}"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="Each profile has its own bookmarks, history, and settings."
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="+ New Profile"
                       Icon="{ui:SymbolIcon Add24}"
                       Command="{Binding CreateProfileCommand}"
                       Style="{StaticResource PrimaryAccentUiButton}"
                       Appearance="Primary"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Row 1: Tiny eyebrow — active profile is already shown in title-bar pill. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                <Run Text="{Binding Profiles.Count, Mode=OneWay}"/>
                <Run Text=" PROFILES · "/>
                <Run Text="{Binding ActiveProfile.Name, Mode=OneWay}"/>
                <Run Text=" ACTIVE"/>
            </TextBlock>
            <Border Width="3" Height="3" CornerRadius="2"
                    Background="{DynamicResource TextFillColorTertiaryBrush}"
                    VerticalAlignment="Center"
                    Margin="10,0,10,0"/>
            <TextBlock Text="{Binding ActiveProfileChannelSummary}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Row 2: Profile list -->
        <ListView Grid.Row="2"
                  ItemsSource="{Binding Profiles}"
                  Background="Transparent"
                  ItemContainerStyle="{StaticResource ProfileRowItemStyle}"
                  BorderThickness="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0"
                                Width="32" Height="32"
                                CornerRadius="16"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{Binding Color, Converter={StaticResource StringToBrush}}">
                            <TextBlock Text="{Binding Name[0]}"
                                       FontSize="14" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Name -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                <Setter Property="Text" Value="Default profile"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Switch — the dominant action, indigo Primary -->
                        <ui:Button Grid.Column="3"
                                   Content="Switch"
                                   Style="{StaticResource PrimaryAccentUiButton}"
                                   Appearance="Primary"
                                   Padding="10,3"
                                   FontSize="11"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}"/>

                        <!-- More menu — color + delete tucked away to declutter the row -->
                        <ui:Button Grid.Column="4"
                                   Icon="{ui:SymbolIcon MoreHorizontal24}"
                                   Appearance="Secondary"
                                   ToolTip="More"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Tag="{Binding}"
                                   Click="ProfileMore_Click"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
