<ui:FluentWindow x:Class="BrowserApp.UI.Views.PublishRuleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Publish Rule"
    Height="380" Width="460"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    ExtendsContentIntoTitleBar="True"
    Style="{StaticResource ModernDialogWindowStyle}">

    <Grid Margin="20" Style="{StaticResource FadeInOnLoadModern}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Publish to Marketplace" ShowMinimize="False" ShowMaximize="False" ShowClose="True"/>

        <TextBlock Grid.Row="1" Text="Share this rule with the community. Others will be able to download and use it."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,16"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Rule Name" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="RuleNameInput"
                        IsReadOnly="True"
                        Opacity="0.7"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Description" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="DescriptionInput"
                        PlaceholderText="Describe what this rule does..."
                        AcceptsReturn="True"
                        MinLines="2"
                        MaxLines="4"
                        TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,4">
            <TextBlock Text="Tags (comma-separated)" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="TagsInput"
                        PlaceholderText="e.g. privacy, ads, tracker"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <ui:Button Content="Cancel"
                       IsCancel="True"
                       Click="CancelButton_Click"
                       Margin="0,0,8,0"/>
            <ui:Button Content="Publish"
                       Appearance="Primary"
                       IsDefault="True"
                       Click="PublishButton_Click"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
